# Usa o caminho completo para evitar o erro de short-name no Podman
FROM docker.io/library/ubuntu:24.04

# Evita que o apt-get trave pedindo interações no terminal
ENV DEBIAN_FRONTEND=noninteractive

# Atualiza e instala ferramentas essenciais
RUN apt-get update && apt-get install -y \
    curl \
    git \
    python3 \
    build-essential \
    jq \
    nano \
    sudo \
    && rm -rf /var/lib/apt/lists/*

# Baixa e instala o Node.js v26
RUN curl -fsSL https://deb.nodesource.com/setup_26.x | bash - \
    && apt-get install -y nodejs

# Instala o Claude Code globalmente, embutindo-o na imagem do container
RUN npm install -g @anthropic-ai/claude-code

# Cria o usuário comum "node" com permissão de sudo sem senha
RUN useradd -m -s /bin/bash node \
    && usermod -aG sudo node \
    && echo "node ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Define o usuário padrão e o diretório de trabalho
USER node
WORKDIR /app

# Mantém o container vivo no segundo plano
CMD ["sleep", "infinity"]